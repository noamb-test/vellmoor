{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16" }
      }
    },
    "presence": {
      "$map": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['n','x','y','d']) && newData.child('n').val() === root.child('users/'+auth.uid+'/name').val())"
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "battles": {
      "$bid": {
        ".read": "auth != null && (data.child('a').val() === auth.uid || data.child('to').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('a').val() === auth.uid) || data.child('a').val() === auth.uid || data.child('to').val() === auth.uid)"
      }
    }
  }
}
